{
  "expo": {
    "name": "TheOrbit – Resonance Instrument",
    "slug": "coherence-journal",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aethonflow.coherencejournal"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.aethonflow.coherencejournal",
      "versionCode": 18
    },
    "newArchEnabled": false,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "scheme": "coherence-journal",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8e74b093-bb78-4546-b0be-3cbe49f3d7af"
      }
    }
  }
}
