{
  "expo": {
    "name": "Coherence Journal",
    "slug": "coherence-journal",
    "scheme": "coherencejournal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06080A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.aethonflow.coherencejournal",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Listen to resonance tones",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "io.aethonflow.coherencejournal",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06080A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["VIBRATE"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
